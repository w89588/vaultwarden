/**** START 静态 Vaultwarden 修改 ****/
/* 将所有继承该选择器的样式合并为一条规则 */
%vw-hide {
  display: none !important;
}

/* 这样可以在浏览器的开发者工具中通过 head 标签搜索到合并后的样式 */
.vw-hide,
head {
  @extend %vw-hide;
}

/* 隐藏订阅页面标签 */
bit-nav-item[route="settings/subscription"] {
  @extend %vw-hide;
}

/* 隐藏指向 Bitwarden 免费家庭版的所有链接 */
a[href$="/settings/sponsored-families"] {
  @extend %vw-hide;
}

/* 隐藏 SSO 登录中的「邮箱」输入框 */
{{#if (not sso_enabled)}}
.vw-email-sso {
  @extend %vw-hide;
}
{{/if}}

/* 隐藏默认/继续登录中的「邮箱」输入框 */
{{#if sso_enabled}}
.vw-email-continue {
  @extend %vw-hide;
}
{{/if}}

/* 隐藏登录页面的「继续」按钮 */
{{#if sso_enabled}}
.vw-continue-login {
  @extend %vw-hide;
}
{{/if}}

/* 隐藏登录页面的「企业级单点登录」按钮 */
{{#if (webver ">=2025.5.1")}}
{{#if (not sso_enabled)}}
.vw-sso-login {
  @extend %vw-hide;
}
{{/if}}
{{else}}
app-root ng-component > form > div:nth-child(1) > div > button[buttontype="secondary"].\!tw-text-primary-600:nth-child(4) {
  @extend %vw-hide;
}
{{/if}}

/* 隐藏「使用 Passkey 登录」相关设置 */
app-user-layout app-password-settings app-webauthn-login-settings {
  @extend %vw-hide;
}
/* 隐藏登录页面上「使用 Passkey 登录」入口 */
{{#if (webver ">=2025.5.1")}}
.vw-passkey-login {
  @extend %vw-hide;
}
{{else}}
app-root ng-component > form > div:nth-child(1) > div > button[buttontype="secondary"].\!tw-text-primary-600:nth-child(3) {
  @extend %vw-hide;
}
{{/if}}

/* 隐藏上述两个被隐藏按钮之间的「或」文字 */
{{#if (webver ">=2025.5.1")}}
{{#if (or (not sso_enabled) sso_only)}}
.vw-or-text {
  @extend %vw-hide;
}
{{/if}}
{{else}}
app-root ng-component > form > div:nth-child(1) > div:nth-child(3) > div:nth-child(2) {
  @extend %vw-hide;
}
{{/if}}

/* 隐藏登录页面的「其他」按钮 */
{{#if (or (not sso_enabled) sso_only)}}
.vw-other-login {
  @extend %vw-hide;
}
{{/if}}

/* 隐藏组织设置中的两步登录菜单 */
bit-nav-item[route="settings/two-factor"],
a[href$="/settings/two-factor"] {
  @extend %vw-hide;
}

/* 隐藏组织套餐 */
app-organization-plans > form > bit-section:nth-child(2) {
  @extend %vw-hide;
}

/* 隐藏集合管理表单 */
app-org-account form.ng-untouched:nth-child(5) {
  @extend %vw-hide;
}

/* 隐藏组织报告中的「成员访问」报告卡片 */
app-org-reports-home > app-report-list > div.tw-inline-grid > div:nth-child(6) {
  @extend %vw-hide;
}

/* 隐藏两步登录页面的设备验证表单 */
app-security > app-two-factor-setup > form {
  @extend %vw-hide;
}

/* 隐藏不支持的自定义角色选项 */
:is(bit-dialog, [bit-dialog]) div.tw-ml-4:has(bit-form-control input),
:is(bit-dialog, [bit-dialog]) div.tw-col-span-4:has(input[formcontrolname*="access"], input[formcontrolname*="manage"]) {
  @extend %vw-hide;
}

/* 将折叠菜单的图标替换为 Vaultwarden 图标 */
bit-nav-logo bit-nav-item a:before {
  content: "";
  background-image: url("../images/icon-white.svg");
  background-repeat: no-repeat;
  background-position: center center;
  height: 32px;
  display: block;
}
bit-nav-logo bit-nav-item .bwi-shield {
  @extend %vw-hide;
}
/* 隐藏用户设置页中的「设备登录保护」按钮 */
app-user-layout app-danger-zone button:nth-child(1) {
  @extend %vw-hide;
}

/* 隐藏不支持的邮箱别名转发选项 */
ng-dropdown-panel div.ng-dropdown-panel-items div:has(> [title="Firefox Relay"]) {
  @extend %vw-hide;
}
ng-dropdown-panel div.ng-dropdown-panel-items div:has(> [title="DuckDuckGo"]) {
  @extend %vw-hide;
}
/**** END 静态 Vaultwarden 修改 ****/
/**** START 动态 Vaultwarden 修改 ****/
{{#if signup_disabled}}
/* 自 web 密码库 2025.1.2 起，当禁用注册时，注册按钮会被隐藏，
  因为 web 密码库会检查 /api/config 接口。
  请注意，客户端通常会将该接口缓存约 1 小时，因此更改可能需要
  一些时间才能生效。为了避免按钮在不应该显示时短暂出现，
  我们将这个样式在几个版本内保留。*/
/* 隐藏登录页面的注册链接 */
{{#if (webver "<2025.3.0")}}
app-login form div + div + div + div + hr,
app-login form div + div + div + div + hr + p {
  @extend %vw-hide;
}
{{else}}
app-root a[routerlink="/signup"] {
  @extend %vw-hide;
}
{{/if}}
{{/if}}

{{#if remember_2fa_disabled}}
/* 隐藏「记住两步登录令牌 30 天」的复选框 */
app-two-factor-auth > form > bit-form-control {
  @extend %vw-hide;
}
{{/if}}

{{#unless mail_2fa_enabled}}
/* 在未启用邮件两步登录时隐藏「邮箱」两步登录 */
.providers-2fa-1 {
  @extend %vw-hide;
}
{{/unless}}

{{#unless yubico_enabled}}
/* 在未启用 YubiKey 时隐藏「YubiKey OTP 安全密钥」两步登录 */
.providers-2fa-3 {
  @extend %vw-hide;
}
{{/unless}}

{{#unless webauthn_2fa_supported}}
/* 在不支持 Passkey 时隐藏「Passkey」两步登录 */
.providers-2fa-7 {
  @extend %vw-hide;
}
{{/unless}}

{{#unless emergency_access_allowed}}
/* 不允许时隐藏紧急访问 */
bit-nav-item[route="settings/emergency-access"] {
  @extend %vw-hide;
}
{{/unless}}

{{#unless sends_allowed}}
/* 不允许时隐藏 Send */
bit-nav-item[route="sends"] {
  @extend %vw-hide;
}
{{/unless}}

{{#unless password_hints_allowed}}
/* 不允许时隐藏密码提示 */
a[routerlink="/hint"],
{{#if (webver "<2025.12.2")}}
app-change-password > form > .form-group:nth-child(5),
auth-input-password > form > bit-form-field:nth-child(4) {
{{else}}
.vw-password-hint {
{{/if}}
  @extend %vw-hide;
}
{{/unless}}
/**** END 动态 Vaultwarden 修改 ****/
/**** 引入用户自定义样式表以支持进一步的修改 ****/
{{#if load_user_scss}}
{{> scss/user.vaultwarden.scss }}
{{/if}}